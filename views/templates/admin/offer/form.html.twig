{# Outside "content": a block nested in another block is rendered twice (in place
   and by the layout) - every script on the page ran twice, e.g. double confirm
   dialogs and requests for close / reopen #}
{% block javascripts %}
    {{ parent() }}

    {# Include offer form validation with tab badges #}
    {% include '@Modules/inpostvonhalsky/views/templates/admin/_partials/js_i18n.html.twig' %}
    <script src="{{ module_js_path }}offer-form.js"></script>

    {# GOKINT-927: productization hint picker (edit modal + create-mode suggestions) #}
    {% if hint_enabled is defined and hint_enabled %}
        <script src="{{ module_js_path }}hint-picker.js"></script>
    {% endif %}

    {% if mode == 'edit' %}
        {% include '@Modules/inpostvonhalsky/views/templates/admin/offer/_category_change_i18n.html.twig' %}
        <script src="{{ module_js_path }}offer-category-change.js"></script>
    {% endif %}

    {% if mode == 'edit' %}
        {% include '@Modules/inpostvonhalsky/views/templates/admin/offer/_attachments_i18n.html.twig' %}
        <script src="{{ module_js_path }}offer-attachments.js"></script>
    {% endif %}

    {# Include offer events AJAX loader #}
    {% if mode == 'edit' and offer.inpostOfferId %}
        <script src="{{ module_js_path }}offer_events.js"></script>
    {% endif %}

    <script>
    (function($) {
        'use strict';

        // Multi-value dictionary attributes
        if ($.fn.select2) {
            $('.js-inpost-multiselect').each(function() {
                $(this).select2({
                    width: '100%',
                    placeholder: '{{ 'Select one or more...'|trans({}, 'Modules.Inpostvonhalsky.Admin')|e('js') }}'
                });
            });
        }

        // "Delete" in the form footer submits the delete form kept outside the offer form
        $('.js-offer-delete-trigger').on('click', function() {
            $('#offer-delete-holder .js-offer-delete-form button[type="submit"]').trigger('click');
        });

        // Back on the attributes tab after "Read again from PrestaShop"
        if (window.location.hash === '#inpost-attributes-tab') {
            $('.nav-tabs a[href="#inpost-attributes-tab"]').tab('show');
        }

        // InPost price: the manual price only in the manual mode (GOKINT-1098)
        var $priceMode = $('input[name$="[price_mode]"]');
        function togglePriceMode() {
            var manual = $priceMode.filter(':checked').val() === 'manual';
            $('#inpost-manual-price-row').toggle(manual);
            $('#inpost-price-auto-help').toggle(!manual);
        }
        $priceMode.on('change', togglePriceMode);
        togglePriceMode();
    })(jQuery);
    </script>

    <script>
    (function($) {
        'use strict';

        const productAutocompleteUrl = '{{ path('inpost_ajax_product_autocomplete') }}';
        const offersCreateUrl = '{{ path('inpost_offers_create') }}';

        const $search = $('.product-autocomplete');
        const $hidden = $('input[name="offer[prestashop_offer_id]"]');

        if ($search.length) {
            // Initialize jQuery UI Autocomplete
            $search.autocomplete({
                source: function(request, response) {
                    $.getJSON(productAutocompleteUrl, { q: request.term })
                        .done(function(data) {
                            if (!data.success || !data.products) {
                                response([]);
                                return;
                            }

                            // Map products to autocomplete format
                            const items = data.products.map(function(product) {
                                return {
                                    label: product.name
                                        + (product.combination ? ' - ' + product.combination : '')
                                        + (product.sku ? ' (' + product.sku + ')' : ''),
                                    value: product.name,
                                    id: product.id,
                                    productAttributeId: product.id_product_attribute || 0
                                };
                            });

                            response(items);
                        })
                        .fail(function() {
                            response([]);
                        });
                },
                minLength: 2,
                select: function(event, ui) {
                    // Set hidden field value
                    $hidden.val(ui.item.id);

                    // Redirect to create page with product_id to pre-fill form
                    // Preserve existing query parameters (like _token)
                    // A combination found by its own SKU/EAN goes straight to it; a product
                    // with combinations gets the variant choice first
                    const sep = offersCreateUrl.indexOf('?') !== -1 ? '&' : '?';
                    window.location = offersCreateUrl + sep + 'product_id=' + encodeURIComponent(ui.item.id)
                        + (ui.item.productAttributeId > 0 ? '&product_attribute_id=' + ui.item.productAttributeId : '');

                    return false;
                },
                appendTo: 'body'
            });
        }

        // Disable is_draft checkbox if InPost Offer ID exists
        (function() {
            const inpostOfferId = {{ (offer.inpostOfferId ?: null)|json_encode(constant('JSON_HEX_TAG'))|raw }};
            const draftCheckbox = $('.js-draft-toggle').closest('.form-group').find('select');

            if (draftCheckbox.length && inpostOfferId) {
                // Disable is_draft checkbox
                draftCheckbox.prop('disabled', true);
                draftCheckbox.css('opacity', '0.6');

                // Add explanatory text (only once)
                const label = $('.js-draft-toggle').closest('.form-group').find('label').first();
                if (label.length && !label.find('.text-muted').length) {
                    label.append(' <small class="text-muted">{{ '(Cannot modify - already submitted to InPost)'|trans({}, 'Modules.Inpostvonhalsky.Admin')|e('js') }}</small>');
                }
            }
        })();

        // Handle InPost category change - redirect with product_id + inpost_category_id
        (function() {
            const $categorySelect = $('.inpost-category-select');

            if ($categorySelect.length && !$categorySelect.prop('readonly') && !$categorySelect.prop('disabled')) {
                const productId = $categorySelect.data('product-id');
                const productAttributeId = parseInt($categorySelect.data('product-attribute-id') || 0, 10);
                const offersCreateUrl = '{{ path('inpost_offers_create') }}';

                if (productId) {
                    $categorySelect.on('change', function() {
                        const categoryId = $(this).val();

                        if (categoryId) {
                            // Redirect with both product_id and inpost_category_id
                            const sep = offersCreateUrl.indexOf('?') !== -1 ? '&' : '?';
                            window.location = offersCreateUrl + sep +
                                'product_id=' + encodeURIComponent(productId) +
                                (productAttributeId > 0 ? '&product_attribute_id=' + productAttributeId : '') +
                                '&inpost_category_id=' + encodeURIComponent(categoryId);
                        }
                    });
                }
            }
        })();

        // Initialize offer events loader (only when offer has InPost ID)
        {% if mode == 'edit' and offer.inpostOfferId %}
        if (typeof InpostOfferEvents !== 'undefined') {
            InpostOfferEvents.init(
                {{ offer.id }},
                '{{ path('inpost_ajax_events_list') }}'
            );
        }
        {% endif %}

        // Apply tab error badges from server-side validation
        {% if form.vars.submitted and not form.vars.valid %}
        $(document).ready(function() {
            // Clear any existing badges first
            $('.nav-tabs .nav-link .badge').remove();
            $('.nav-tabs .nav-link').removeClass('tab-has-errors');

            // Count errors per tab by checking .is-invalid fields (unique per form-group)
            var tabErrors = {};
            $('.tab-pane').each(function() {
                var tabId = $(this).attr('id');
                // Count form-groups with errors (deduped), not individual error elements
                var errorGroups = new Set();
                $(this).find('.is-invalid, .has-error').each(function() {
                    var $group = $(this).closest('.form-group');
                    if ($group.length) {
                        errorGroups.add($group[0]);
                    }
                });
                tabErrors[tabId] = errorGroups.size;
            });

            var firstErrorTab = null;
            $.each(tabErrors, function(tabId, errorCount) {
                if (errorCount > 0) {
                    var $tabLink = $('.nav-tabs a[href="#' + tabId + '"]');
                    $tabLink.addClass('tab-has-errors');
                    $tabLink.append('<span class="badge badge-danger ml-2">' + errorCount + '</span>');

                    if (!firstErrorTab) {
                        firstErrorTab = tabId;
                    }
                }
            });

            // Switch to first tab with errors
            if (firstErrorTab) {
                $('.nav-tabs a[href="#' + firstErrorTab + '"]').tab('show');
            }
        });
        {% endif %}
    })(jQuery);
    </script>
{% endblock %}
