{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% form_theme form '@Modules/inpostvonhalsky/views/templates/admin/offer/_form_theme.html.twig' %}

{% block content %}
<div class="inpost-offer-form container-xl">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11 col-xxl-9">
            <h1 class="page-title">
                <i class="material-icons">shopping_cart</i>
                {{ mode == 'create' ? 'Create New Offer'|trans({}, 'Modules.Inpostvonhalsky.Admin') : 'Edit Offer #%id%'|trans({'%id%': offer.id}, 'Modules.Inpostvonhalsky.Admin') }}
            </h1>
        </div>
    </div>

    {# Validation Status from InPost API #}
    {% if offer.status == 'ERROR_NOT_CREATED' %}
        {# The offer failed to be created on InPost — do not show a green "valid"
           local-validation state here; surface the API failure reason instead. #}
        <div class="row mb-3 justify-content-center">
            <div class="col-12 col-xl-11 col-xxl-9">
                <div class="alert alert-danger">
                    <strong>{{ 'InPost Validation Status:'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</strong>
                    {{ 'Not created'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                    {% if offer.commandError %}
                        <div class="mt-2">
                            <i class="material-icons" style="vertical-align: middle;">error</i>
                            <strong>{{ 'InPost API error:'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</strong>
                            {{ offer.commandError }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% elseif offer.inpostValidationStatus is defined and offer.inpostValidationStatus %}
        <div class="row mb-3 justify-content-center">
            <div class="col-12 col-xl-11 col-xxl-9">
                <div class="alert {{ offer.inpostValidationStatus == 'VALID' ? 'alert-success' : 'alert-warning' }}">
                    <strong>{{ 'InPost Validation Status:'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</strong>
                    {% set status_map = {'VALID': 'Valid', 'INVALID': 'Invalid', 'WARNING': 'Valid with Warnings'} %}
                    {{ (status_map[offer.inpostValidationStatus] ?? offer.inpostValidationStatus)|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                    {% if offer.syncedAt %}
                        <br><small>{{ 'Last synced:'|trans({}, 'Modules.Inpostvonhalsky.Admin') }} {{ offer.syncedAt|date('Y-m-d H:i:s') }}</small>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}

    {# Validation Messages #}
    {% if validation is defined and validation.messages|length > 0 %}
        <div class="row mb-3 justify-content-center">
            <div class="col-12 col-xl-11 col-xxl-9">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-header-title">
                            <i class="material-icons">{{ validation.can_submit ? 'check_circle' : 'error' }}</i>
                            {{ 'Validation Results'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                        </h3>
                    </div>
                    <div class="card-body">
                        {% for message in validation.messages %}
                            {% set alert_class = {
                                'error': 'alert-danger',
                                'warning': 'alert-warning',
                                'info': 'alert-info'
                            } %}
                            <div class="alert {{ alert_class[message.severity]|default('alert-info') }}">
                                <strong>{{ message.severity|upper }}:</strong> {{ message.message|trans(message.params|default({}), 'Modules.Inpostvonhalsky.Admin') }}
                                {% if message.field %}
                                    <br><small>{{ 'Field:'|trans({}, 'Modules.Inpostvonhalsky.Admin') }} {{ message.field }}</small>
                                {% endif %}
                            </div>
                        {% endfor %}

                        {% if offer.status == 'ERROR_NOT_CREATED' %}
                            <div class="alert alert-danger">
                                <i class="material-icons">error</i>
                                <strong>{{ 'Offer was not created. See the InPost API error above.'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</strong>
                            </div>
                        {% elseif validation.can_submit %}
                            <div class="alert alert-success">
                                <i class="material-icons">check_circle</i>
                                <strong>{{ 'Offer is ready to send!'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</strong>
                            </div>
                        {% elseif validation.is_valid %}
                            {# Valid but blocked (e.g., draft mode) - show info, not error #}
                            <div class="alert alert-info">
                                <i class="material-icons">info</i>
                                <strong>{{ 'Offer is valid but not ready to send.'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</strong> {{ 'Check info messages above.'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                            </div>
                        {% else %}
                            <div class="alert alert-danger">
                                <i class="material-icons">error</i>
                                <strong>{{ 'Offer has validation errors and cannot be sent.'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</strong>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# Show validation error alert if form was submitted with errors #}
    {% if form.vars.submitted and not form.vars.valid %}
        <div class="row mb-3 justify-content-center">
            <div class="col-12 col-xl-11 col-xxl-9">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="material-icons mr-2" style="vertical-align: middle;">error</i>
                    <strong>{{ 'Validation failed!'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</strong> {{ 'Please check the highlighted tabs and fix the errors.'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
            </div>
        </div>
    {% endif %}

    {# Calculate tab error counts #}
    {% set offer_details_errors = 
        form.inpost_category.vars.errors|length + 
        form.prestashop_offer_id.vars.errors|length %}
    {% set product_details_errors = 
        form.product_name.vars.errors|length + 
        form.product_description.vars.errors|length + 
        form.product_sku.vars.errors|length + 
        form.product_ean.vars.errors|length + 
        form.product_brand.vars.errors|length + 
        form.product_model.vars.errors|length %}
    {% set gpsr_errors = 
        form.manufacturer_name.vars.errors|length + 
        form.manufacturer_email.vars.errors|length + 
        form.manufacturer_address_country_code.vars.errors|length + 
        form.gpsr_does_not_require_info.vars.errors|length %}
    {% set policies_errors = 0 %}
    {% set attributes_errors = 0 %}
    {% if form.inpost_attributes is defined %}
        {% for attr in form.inpost_attributes %}
            {% set attributes_errors = attributes_errors + attr.vars.errors|length %}
        {% endfor %}
    {% endif %}

    {# Offer Form #}
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11 col-xxl-9">
            {{ form_start(form, {'attr': {'class': 'w-100', 'novalidate': 'novalidate', 'id': 'offer-form'}}) }}
            {% if category_change is defined and category_change %}
                {% include '@Modules/inpostvonhalsky/views/templates/admin/offer/_category_change_banner.html.twig' with {cc: category_change} %}
            {% endif %}

            <div class="card">
                <div class="card-body">
                    {# Tabs Navigation - Updated Structure #}
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active {{ offer_details_errors > 0 ? 'tab-has-errors' : '' }}" data-toggle="tab" href="#offer-details-tab" role="tab">
                                <i class="material-icons">info</i>
                                {{ 'Offer Details'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                                {% if offer_details_errors > 0 %}<span class="badge badge-danger ml-1">{{ offer_details_errors }}</span>{% endif %}
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ product_details_errors > 0 ? 'tab-has-errors' : '' }}" data-toggle="tab" href="#product-details-tab" role="tab">
                                <i class="material-icons">inventory</i>
                                {{ 'Product Details'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                                {% if product_details_errors > 0 %}<span class="badge badge-danger ml-1">{{ product_details_errors }}</span>{% endif %}
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ gpsr_errors > 0 ? 'tab-has-errors' : '' }}" data-toggle="tab" href="#gpsr-manufacturer-tab" role="tab">
                                <i class="material-icons">business</i>
                                {{ 'GPSR and Manufacturer Details'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                                {% if gpsr_errors > 0 %}<span class="badge badge-danger ml-1">{{ gpsr_errors }}</span>{% endif %}
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="tab" href="#policies-shipping-tab" role="tab">
                                <i class="material-icons">description</i>
                                {{ 'Policies & Shipping'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ attributes_errors > 0 ? 'tab-has-errors' : '' }}" data-toggle="tab" href="#inpost-attributes-tab" role="tab">
                                <i class="material-icons">list</i>
                                {{ 'InPost Attributes'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                                {% if attributes_errors > 0 %}<span class="badge badge-danger ml-1">{{ attributes_errors }}</span>{% endif %}
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="tab" href="#events-tab" role="tab">
                                <i class="material-icons">event_note</i>
                                {{ 'Events'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                            </a>
                        </li>
                        {% if mode == 'edit' %}
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="tab" href="#attachments-tab" role="tab">
                                <i class="material-icons">attach_file</i>
                                {{ 'Attachments'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                                <span class="badge badge-secondary ml-1 js-attachments-count"></span>
                            </a>
                        </li>
                        {% endif %}
                    </ul>

                    {# Tab Content #}
                    <div class="tab-content">
                        {# Tab 1: Offer Details (renamed from "Basic Info") #}
                        <div class="tab-pane fade show active" id="offer-details-tab" role="tabpanel">
                            <div class="form-group-section">
                                <h3>{{ 'Organization'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</h3>
                                {{ form_row(form.organization_display) }}
                                {{ form_widget(form.organizationId) }}
                            </div>

                            <div class="form-group-section">
                                <h3>{{ 'Product Selection'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</h3>
                                {% if mode == 'create' %}
                                    {{ form_row(form.product_search) }}
                                    {{ form_widget(form.prestashop_offer_id) }}
                                    {% if offer.prestashopOfferId %}
                                        {% include '@Modules/inpostvonhalsky/views/templates/admin/offer/_selected_product.html.twig' with {'locked': false} %}
                                    {% endif %}

                                    {# GOKINT-927: productization suggestions by EAN during create #}
                                    {% if hint_enabled is defined and hint_enabled and product_id and offer.product is not null and offer.product.ean %}
                                        <div id="hint-create-panel"
                                             class="mt-3"
                                             data-search-url="{{ path('inpost_ajax_offer_hint_search') }}"
                                             data-prepare-url="{{ path('inpost_ajax_offer_hint_prepare') }}"
                                             data-product-id="{{ product_id }}"
                                             data-product-attribute-id="{{ offer.prestashopProductAttributeId }}"
                                             data-ean="{{ offer.product.ean }}">
                                            <div class="card border-primary">
                                                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                                    <span>
                                                        <i class="material-icons" style="vertical-align: middle;">auto_fix_high</i>
                                                        {{ 'InPost catalogue suggestions'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                                                    </span>
                                                    <button type="button" class="btn btn-sm btn-light" id="hint-create-refresh">
                                                        {{ 'Search again'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                                                    </button>
                                                </div>
                                                <div class="card-body">
                                                    <p class="text-muted mb-2">
                                                        {{ 'Products matched by EAN in the InPost catalogue. Selecting one maps the category (if needed) and fills attributes automatically.'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                                                    </p>
                                                    <div id="hint-create-results"></div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% else %}
                                    {{ form_widget(form.prestashop_offer_id) }}
                                    {% include '@Modules/inpostvonhalsky/views/templates/admin/offer/_selected_product.html.twig' with {'locked': true} %}
                                {% endif %}
                            </div>

                            <div class="form-group-section">
                                <h3>{{ 'Category'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</h3>
                                {% set category_locked = inpost_category_name is defined and inpost_category_name and mode == 'edit' %}
                                {% if category_locked %}
                                    {{ form_widget(form.inpost_category) }}
                                {% else %}
                                    {{ form_row(form.inpost_category) }}
                                {% endif %}
                                {% set ci = category_info|default(null) %}
                                {% if ci or category_locked or mode == 'edit' %}
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-sm-3"></div>
                                            <div class="col-sm-9">
                                                <div class="inpost-offer-category">
                                                    <div class="inpost-offer-category-row">
                                                        <span class="inpost-cat-tag inpost-cat-tag-shop">{{ 'Shop category'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</span>
                                                        <span>
                                                            {% if ci and ci.ps_categories|length %}
                                                                {% for psc in ci.ps_categories %}
                                                                    <strong>{{ psc.name }}</strong>{% if psc.is_default %} <span class="text-muted">({{ 'default category of the product'|trans({}, 'Modules.Inpostvonhalsky.Admin') }})</span>{% endif %}{% if not loop.last %}, {% endif %}
                                                                {% endfor %}
                                                            {% else %}
                                                                <span class="text-muted">{{ 'not linked - category taken from the offer in InPost'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</span>
                                                            {% endif %}
                                                        </span>
                                                    </div>
                                                    <div class="inpost-offer-category-arrow"><i class="material-icons">arrow_downward</i></div>
                                                    <div class="inpost-offer-category-row">
                                                        <span class="inpost-cat-tag inpost-cat-tag-inpost">{{ 'InPost category'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</span>
                                                        <span>
                                                            {% if ci %}
                                                                {% for name in ci.inpost_path %}{% if loop.last %}<strong>{{ name }}</strong>{% else %}<span class="text-muted">{{ name }} › </span>{% endif %}{% endfor %}
                                                            {% else %}
                                                                <strong>{{ inpost_category_name|default('-') ?: '-' }}</strong>
                                                            {% endif %}
                                                        </span>
                                                    </div>
                                                </div>
                                                {% if mode == 'edit' and category_change is defined and category_change %}
                                                    <small class="form-text text-warning"><i class="material-icons" style="font-size:14px;vertical-align:-2px;">swap_horiz</i> {{ 'New category - saved together with the form.'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</small>
                                                {% elseif mode == 'edit' and category_change_block is defined and category_change_block %}
                                                    <small class="form-text text-muted"><i class="material-icons" style="font-size:14px;vertical-align:-2px;">lock</i> {{ category_change_block|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</small>
                                                {% elseif mode == 'edit' %}
                                                    <button type="button" class="btn btn-outline-primary btn-sm mt-2" data-toggle="modal" data-target="#category-change-modal">
                                                        <i class="material-icons">swap_horiz</i>
                                                        {{ 'Change category'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                                                    </button>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="form-group-section">
                                <h3>{{ 'Status & Identifiers'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</h3>

                                {# InPost Validation Status Display #}
                                {% if offer.inpostValidationStatus is defined %}
                                    <div class="form-group">
                                        <div class="row">
                                            <label class="col-sm-3 col-form-label">{{ 'Validation Status'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</label>
                                            <div class="col-sm-4">
                                                <div class="validation-status-display">
                                                    <span class="badge {{ offer.inpostValidationStatus == 'VALID' ? 'badge-success' : 'badge-warning' }}">
                                                        {% set status_map = {'VALID': 'Valid', 'INVALID': 'Invalid', 'WARNING': 'Valid with Warnings'} %}
                                                        {{ (status_map[offer.inpostValidationStatus] ?? offer.inpostValidationStatus ?? 'Not Validated')|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}

                                {# Display InPost API validation errors #}
                                {% set validationErrors = offer.validationErrors|default([]) %}
                                {% if validationErrors|length > 0 %}
                                    <div class="form-group">
                                        <div class="row">
                                            <label class="col-sm-3 col-form-label"></label>
                                            <div class="col-sm-9">
                                                <div class="alert alert-danger mb-0">
                                                    <strong>{{ 'InPost Validation Errors'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}:</strong>
                                                    <ul class="mb-0 mt-2">
                                                        {% for error in validationErrors %}
                                                            <li>
                                                                <strong>{{ error.validationCode|default('ERROR') }}</strong>:
                                                                {{ error.validationMessage|default(error.message|default('Unknown error')) }}
                                                            </li>
                                                        {% endfor %}
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}

                                {# InPost Offer ID (Read-Only) #}
                                <div class="form-group">
                                    <div class="row">
                                        {{ form_label(form.inpost_offer_id, null, {'label_attr': {'class': 'col-form-label col-sm-3'}}) }}
                                        <div class="col-sm-4">
                                            {{ form_widget(form.inpost_offer_id) }}
                                            {{ form_help(form.inpost_offer_id) }}
                                            {% if offer.inpostOfferId %}
                                                <small class="form-text text-success">
                                                    <i class="material-icons">check_circle</i> {{ 'Synced with InPost'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                                                </small>
                                            {% else %}
                                                <small class="form-text text-warning">
                                                    <i class="material-icons">warning</i> {{ 'Not yet submitted to InPost API'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
                                                </small>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                {{ form_row(form.is_draft) }}

                                {# Publication Status with Visual Indicators #}
                                <div class="form-group">
                                    <div class="row">
                                        {{ form_label(form.status, null, {'label_attr': {'class': 'col-form-label col-sm-3'}}) }}
                                        <div class="col-sm-4">
                                            {{ form_widget(form.status) }}
                                            {{ form_help(form.status) }}
                                            <small class="form-text text-muted">
                                                {% if offer.isDraft == 1 %}
                                                    <span class="badge badge-secondary">{{ 'DRAFT MODE'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</span>
                                                {% elseif offer.status == 'PUBLISHED' %}
                                                    <span class="badge badge-success">{{ 'Live on InPost'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</span>
                                                {% elseif offer.status == 'REJECTED' %}
                                                    <span class="badge badge-danger">{{ 'Rejected by InPost'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</span>
                                                {% elseif offer.status == 'PENDING' %}
                                                    <span class="badge badge-info">{{ 'Pending Review'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</span>
                                                {% elseif offer.status == 'CLOSED' %}
                                                    <span class="badge badge-warning">{{ 'Closed'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</span>
                                                {% elseif offer.status == 'SOLDOUT' %}
                                                    <span class="badge badge-dark">{{ 'Sold Out'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</span>
                                                {% elseif offer.status == 'ERROR_NOT_CREATED' %}
                                                    <span class="badge badge-danger">{{ 'Not Created (Error)'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</span>
                                                {% endif %}
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Tab 2: Product Details (moved from Basic Info + added price/stock display) #}
                        <div class="tab-pane fade" id="product-details-tab" role="tabpanel">
                            {# Product Image Preview #}
                            <div class="form-group-section">
                                <h3>{{ 'Product Image'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</h3>
                                <div class="form-group">
                                    <div class="row">
                                        <label class="col-sm-3 col-form-label">{{ 'Preview'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</label>
                                        <div class="col-sm-4">
                                            {% if product_image_url %}
                                                <img src="{{ product_image_url }}"
                                                     alt="{{ 'Product image'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}"
                                                     class="img-thumbnail"
                                                     style="max-width: 200px; height: auto;">
                                            {% else %}
                                                <div class="text-muted p-3 border rounded bg-light text-center">
                                                    <i class="material-icons" style="font-size: 48px; opacity: 0.5;">image</i>
                                                    <br><small>{{ 'No image available'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</small>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group-section">
                                <h3>{{ 'Product Basic Info'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</h3>
                                {{ form_row(form.product_name) }}
                                {{ form_row(form.product_description) }}
                                {{ form_row(form.product_sku) }}
                                {{ form_row(form.product_ean) }}
                                {{ form_row(form.product_brand) }}
                                {{ form_row(form.product_model) }}
                            </div>

                            <div class="form-group-section">
                                <h3>{{ 'Price & Stock'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</h3>
                                <div class="form-group">
                                    <div class="row">
                                        <label class="col-sm-3 col-form-label">{{ 'Stock'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</label>
                                        <div class="col-sm-4">
                                            <input type="text" class="form-control" disabled readonly
                                                   value="{{ offer.stock.quantity ?? 0 }} {{ offer.stock.unit ?? 'UNIT' }} {{ (offer.stock.quantity ?? 0) > 0 ? '✓ ' ~ 'In Stock'|trans({}, 'Modules.Inpostvonhalsky.Admin') : '✗ ' ~ 'Out of Stock'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}">
                                        </div>
                                    </div>
                                </div>
                                {# GOKINT-1098: InPost price - automatic (shop + price settings) or manual #}
                                {% set currency = offer.price.currency ?? 'PLN' %}
                                <div class="form-group">
                                    <div class="row">
                                        <label class="col-sm-3 col-form-label">{{ 'Price in the shop'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}</label>
                                        <div class="col-sm-4">
                                            <input type="text" class="form-control" disabled readonly
                                                   value="{% set shown_shop_price = shop_price ?? offer.price.shopPrice %}{{ shown_shop_price is not null ? shown_shop_price|number_format(2, '.', '') ~ ' ' ~ currency : '—' }}">
                                        </div>
                                    </div>
                                </div>
                                {{ form_row(form.price_mode) }}
                                <div class="form-group">
                                    <div class="row">
                                        <div class="col-sm-9 offset-sm-3">
                                            <small class="form-text text-muted" id="inpost-price-auto-help">
                                                {{ 'Automatic: the shop price with the "InPost prices" settings of the module configuration'|trans({}, 'Modules.Inpostvonhalsky.Admin') }}
