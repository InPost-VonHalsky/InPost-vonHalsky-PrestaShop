{#
/**
 * "Change category" dialog of the offer edit page (views/js/offer-category-change.js):
 * pick an InPost category, see what changes, continue in the form.
 *
 * @author    SII Poland
 * @copyright 2025 SII Poland
 * @license   Commercial
 */
#}
{% set d = 'Modules.Inpostvonhalsky.Admin' %}
<div class="modal fade" id="category-change-modal" tabindex="-1" role="dialog" aria-hidden="true"
     data-offer-id="{{ offer.id }}"
     data-search-url="{{ path('inpost_ajax_offer_category_search') }}"
     data-preview-url="{{ path('inpost_ajax_offer_category_preview') }}">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Change InPost category'|trans({}, d) }}</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Close'|trans({}, d) }}"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">
                    {{ 'Only this offer (and optionally its other variants) is moved - category mappings and offers of other products do not change. Values of attributes the new category does not have are removed.'|trans({}, d) }}
                </p>

                {% if category_quick_choices is defined and category_quick_choices|length %}
                    <label class="font-weight-bold">{{ 'Categories linked to the shop categories of this product'|trans({}, d) }}</label>
                    <div class="list-group mb-3">
                        {% for choice in category_quick_choices %}
                            <button type="button" class="list-group-item list-group-item-action js-cc-pick" data-id="{{ choice.id }}">{{ choice.label }}</button>
                        {% endfor %}
                    </div>
                {% endif %}

                <label class="font-weight-bold" for="cc-search">{{ 'Search all InPost categories'|trans({}, d) }}</label>
                <input type="text" class="form-control" id="cc-search" autocomplete="off" placeholder="{{ 'Category name, at least 2 characters'|trans({}, d) }}">
                <div id="cc-results" class="list-group mt-2 inpost-cc-results"></div>

                <div id="cc-preview" class="mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">{{ 'Close'|trans({}, d) }}</button>
                <a href="#" class="btn btn-primary disabled" id="cc-continue" aria-disabled="true">
                    <i class="material-icons">arrow_forward</i>
                    {{ 'Continue in the form'|trans({}, d) }}
                </a>
            </div>
        </div>
    </div>
</div>
<style>
    .inpost-cc-results { max-height: 260px; overflow-y: auto; }
    .inpost-cc-results .list-group-item small { display: block; color: #6c868e; }
    #cc-preview .cc-section { margin-bottom: .75rem; }
    #cc-preview .cc-section ul { margin-bottom: 0; padding-left: 1.2rem; }
</style>
