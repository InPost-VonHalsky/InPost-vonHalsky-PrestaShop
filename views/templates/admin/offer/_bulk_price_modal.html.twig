{#
/**
 * "Set price" dialog of the offers list (views/js/offer-bulk-price.js, GOKINT-1098):
 * a manual price, the shop price +/- %, or back to the automatic price;
 * preview per offer, then apply.
 *
 * @author    SII Poland
 * @copyright 2025 SII Poland
 * @license   Commercial
 */
#}
{% set d = 'Modules.Inpostvonhalsky.Admin' %}
<div class="modal fade" id="bulk-price-modal" tabindex="-1" role="dialog" aria-hidden="true"
     data-preview-url="{{ path('inpost_ajax_offers_bulk_price_preview') }}"
     data-apply-url="{{ path('inpost_ajax_offers_bulk_price_apply') }}"
     data-csrf="{{ csrf_token('inpost_offers_bulk_price') }}">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Set the InPost price of the selected offers'|trans({}, d) }} <span id="bp-offer-count"></span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Close'|trans({}, d) }}"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">
                    {{ 'The price is set on the InPost offers only, prices in the shop do not change. A manual price no longer follows the shop until you go back to the automatic price.'|trans({}, d) }}
                </p>

                <div id="bp-error" class="alert alert-danger d-none"></div>

                <div class="form-group">
                    <div class="form-check">
                        <input class="form-check-input js-bp-operation" type="radio" name="bp-operation" id="bp-op-manual" value="manual" checked>
                        <label class="form-check-label" for="bp-op-manual">{{ 'Manual price - the same for all offers'|trans({}, d) }}</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input js-bp-operation" type="radio" name="bp-operation" id="bp-op-percent" value="percent">
                        <label class="form-check-label" for="bp-op-percent">{{ 'Manual price - the shop price of each offer changed by a percentage'|trans({}, d) }}</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input js-bp-operation" type="radio" name="bp-operation" id="bp-op-auto" value="auto">
                        <label class="form-check-label" for="bp-op-auto">{{ 'Automatic price - from the shop with the price settings of the module'|trans({}, d) }}</label>
                    </div>
                </div>

                <div class="form-row js-bp-fields" data-operation="manual">
                    <div class="form-group col-md-4">
                        <label for="bp-amount">{{ 'Gross price'|trans({}, d) }}</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="bp-amount" placeholder="99.99" inputmode="decimal">
                            <div class="input-group-append"><span class="input-group-text">PLN</span></div>
                        </div>
                    </div>
                </div>
                <div class="form-row js-bp-fields d-none" data-operation="percent">
                    <div class="form-group col-md-4">
                        <label for="bp-percent">{{ 'Price change'|trans({}, d) }}</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="bp-percent" placeholder="5" inputmode="decimal">
                            <div class="input-group-append"><span class="input-group-text">%</span></div>
                        </div>
                        <small class="form-text text-muted">{{ '5 = 5% more expensive, -5 = 5% cheaper'|trans({}, d) }}</small>
                    </div>
                    <div class="form-group col-md-6">
                        <label for="bp-rounding">{{ 'Rounding'|trans({}, d) }}</label>
                        <select class="form-control" id="bp-rounding">
                            <option value="none">{{ 'None'|trans({}, d) }}</option>
                            <option value="x99">{{ 'Up to ,99 (104.20 -> 104.99)'|trans({}, d) }}</option>
                            <option value="integer">{{ 'To whole zloty (104.49 -> 104.00)'|trans({}, d) }}</option>
                        </select>
                    </div>
                </div>

                <div id="bp-preview" class="mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">{{ 'Close'|trans({}, d) }}</button>
                <button type="button" class="btn btn-outline-primary" id="bp-preview-btn">
                    <i class="material-icons">visibility</i>
                    {{ 'Preview'|trans({}, d) }}
                </button>
                <button type="button" class="btn btn-primary" id="bp-apply-btn" disabled>
                    <i class="material-icons">done</i>
                    {{ 'Apply'|trans({}, d) }}
                </button>
            </div>
        </div>
    </div>
</div>
<style>
    #bp-preview .table { font-size: 12px; }
    #bp-preview .bp-table-wrap { max-height: 360px; overflow-y: auto; }
    #bp-preview tr.bp-skip td { color: #6c868e; }
</style>
<script>
  window.InpostI18n = Object.assign(window.InpostI18n || {}, {{ {
    'Loading...': 'Loading...'|trans({}, d),
    'Request failed': 'Request failed'|trans({}, d),
    'Offer': 'Offer'|trans({}, d),
    'Current price': 'Current price'|trans({}, d),
    'New price': 'New price'|trans({}, d),
    'Result': 'Result'|trans({}, d),
    'Change': 'Change'|trans({}, d),
    'No change': 'No change'|trans({}, d),
    'Skipped': 'Skipped'|trans({}, d),
    'manual': 'manual'|trans({}, d),
    'automatic': 'automatic'|trans({}, d),
    'Changed: %changed%, no change: %same%, skipped: %skipped%': 'Changed: %changed%, no change: %same%, skipped: %skipped%'|trans({}, d),
    'Change the price of %count% offer(s)? Offers already in InPost are sent there within a few minutes.': 'Change the price of %count% offer(s)? Offers already in InPost are sent there within a few minutes.'|trans({}, d)
  }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }});
</script>
