{% use "bootstrap_4_horizontal_layout.html.twig" %}

{% block form_label -%}
    {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ (required ? ' required' : ''))|trim}) %}
    {{- parent() -}}
{%- endblock form_label %}

{% block form_label_class -%}
col-sm-3
{%- endblock form_label_class %}

{% block form_group_class -%}
col-sm-4
{%- endblock form_group_class %}

{% block form_row -%}
    {%- if expanded is defined and expanded -%}
        {{ block('fieldset_form_row') }}
    {%- else -%}
        {%- set widget_attr = {} -%}
        {%- if help is not empty -%}
            {%- set widget_attr = {attr: {'aria-describedby': id ~ "_help"}} -%}
        {%- endif -%}
        <div{% with {attr: row_attr|merge({class: (row_attr.class|default('') ~ ' form-group')|trim})} %}{{ block('attributes') }}{% endwith %}>
            <div class="row{% if (not compound or force_error|default(false)) and not valid %} is-invalid{% endif %}">
                {{- form_label(form) -}}
                <div class="{{ block('form_group_class') }}">
                    {{- form_widget(form, widget_attr) -}}
                    {{- form_help(form) -}}
                </div>
            </div>
        </div>
    {%- endif -%}
{%- endblock form_row %}

{# Help text keeps its own text-* colour class (bootstrap_4 always adds text-muted) #}
{% block form_help -%}
    {%- if help is not empty -%}
        <small id="{{ id }}_help" class="{{ help_attr.class|default('form-text text-muted') }}">
            {%- if translation_domain is same as(false) -%}
                {{- help -}}
            {%- else -%}
                {{- help|trans(help_translation_parameters, translation_domain) -}}
            {%- endif -%}
        </small>
    {%- endif -%}
{%- endblock form_help %}

{% block submit_row -%}
    <div{% with {attr: row_attr|merge({class: (row_attr.class|default('') ~ ' form-group')|trim})} %}{{ block('attributes') }}{% endwith %}>
        <div class="row">
            <div class="{{ block('form_label_class') }}"></div>
            <div class="{{ block('form_group_class') }}">
                {{- form_widget(form) -}}
            </div>
        </div>
    </div>
{%- endblock submit_row %}

{% block reset_row -%}
    <div{% with {attr: row_attr|merge({class: (row_attr.class|default('') ~ ' form-group')|trim})} %}{{ block('attributes') }}{% endwith %}>
        <div class="row">
            <div class="{{ block('form_label_class') }}"></div>
            <div class="{{ block('form_group_class') }}">
                {{- form_widget(form) -}}
            </div>
        </div>
    </div>
{%- endblock reset_row %}

{% block checkbox_row -%}
    <div{% with {attr: row_attr|merge({class: (row_attr.class|default('') ~ ' form-group')|trim})} %}{{ block('attributes') }}{% endwith %}>
        <div class="row">
            <div class="{{ block('form_label_class') }}"></div>
            <div class="{{ block('form_group_class') }}">
                {{- form_widget(form) -}}
                {{- form_help(form) -}}
            </div>
        </div>
    </div>
{%- endblock checkbox_row %}
